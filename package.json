{
  "name": "seojin-stock-reservation",
  "version": "0.1.0",
  "private": true,
  "description": "TTL 기반 재고 예약과 낙관적 잠금으로 동시 주문의 초과 판매를 방지하는 서비스",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "2.1.1",
    "hono": "4.13.8",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "tsx": "4.23.13",
    "typescript": "5.7.2",
    "vitest": "2.1.9"
  }
}
